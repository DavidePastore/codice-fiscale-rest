{
    "name": "davidepastore/codice-fiscale-rest",
    "description": "A simple codice fiscale rest website based on Symfony.",
    "keywords": ["codice","fiscale","rest","symfony", "tax", "code", "italian", "italy", "php"],
    "authors": [
        {
            "name": "Davide Pastore",
            "email": "pasdavide@gmail.com"
        }
    ],
    "type": "library",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "davidepastore/codice-fiscale": "^0.8.0",
        "nelmio/cors-bundle": "^2.5",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/webpack-encore-bundle": "^2.2",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.12",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "DavidePastore\\CodiceFiscaleRest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DavidePastore\\CodiceFiscaleRest\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
